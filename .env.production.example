# Production overlay — copy real values into Railway/deployment variables.
# Never commit real credentials. Live production accounts must not receive demo fallback.

DEMO_MODE=false
APP_ENV=production
SECRET_KEY=
ALLOWED_ORIGINS=https://build-opt.site,https://www.build-opt.site
TIMEZONE=Asia/Dubai

# InfluxDB
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=buildopt
INFLUX_BUCKET=building_metrics

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
TELEMETRY_STORE_BACKEND=auto

# Alert / notification delivery
SUPABASE_ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_TEAMS_WEBHOOK_URL=
NOTIFICATION_SLACK_WEBHOOK_URL=
NOTIFICATION_WHATSAPP_WEBHOOK_URL=

# Johnson Controls Metasys (optional global connector; prefer building-scoped credentials)
JCI_METASYS_HOST=
JCI_METASYS_USERNAME=
JCI_METASYS_PASSWORD=
JCI_METASYS_VERSION=v4

# Edge gateway ingest
INGEST_API_KEY=
POLL_INTERVAL_SECONDS=30

# Edge connector examples — normally configured on the edge host, not Railway
# BACNET_IP=192.168.1.100
# BACNET_PORT=47808
# MODBUS_HOST=192.168.1.101
# MODBUS_PORT=502
# MQTT_BROKER=192.168.1.50
# MQTT_PORT=1883
# MQTT_USERNAME=buildopt
# MQTT_PASSWORD=

# GCC/localization helpers
PRAYER_API_KEY=
LATITUDE=25.2048
LONGITUDE=55.2708
